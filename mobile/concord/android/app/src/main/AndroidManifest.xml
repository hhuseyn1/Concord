<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET was missing from this file entirely before Phase 5 - every
         REST/SignalR call this app makes needs it, and (unlike the debug/
         profile manifests, which the Flutter tool adds it to automatically
         for hot reload) a release build only gets it if it's declared here.
         RECORD_AUDIO/CAMERA/MODIFY_AUDIO_SETTINGS/BLUETOOTH_CONNECT are new
         with this phase's voice/video calling (`livekit_client`, which
         requires them at manifest level regardless of the runtime
         permission prompt). -->
    <!-- POST_NOTIFICATIONS is a runtime permission on Android 13+ (API 33+) - without it declared
         here, permission_handler's Permission.notification check/request in
         push_notifications_controller.dart has nothing to prompt for, and no push notification
         (firebase_messaging) can ever be shown regardless of what the app does in Dart. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <application
        android:label="concord"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Custom URL scheme deep links (invite links, password-reset links) - a plain
                 `concord://` scheme, not an https Android App Link, since App Links require owning
                 a domain and hosting a verified `assetlinks.json`, which this project doesn't have.
                 No plugin is needed to receive these: Flutter's engine turns the incoming Intent's
                 data URI into the initial/updated route, which `go_router`'s top-level `redirect` in
                 `app_router.dart` then normalizes and matches. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="concord"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
